{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "! file name, !& selected files, !/ current folder, !@ host, !U user, !# port, !N site name, !?Prompt:?default! asks for a value, !! a literal !. Names and answers are quoted for the shell." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "! Dateiname, !& ausgewählte Dateien, !/ aktueller Ordner, !@ Host, !U Benutzer, !# Port, !N Name der Site, !?Frage:?Standard! fragt nach einem Wert, !! ein wörtliches !. Namen und Antworten werden für die Shell maskiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "! nombre de archivo, !& archivos seleccionados, !/ carpeta actual, !@ host, !U usuario, !# puerto, !N nombre del sitio, !?Pregunta:?predeterminado! pide un valor, !! un ! literal. Los nombres y respuestas se entrecomillan para el shell."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "! nom du fichier, !& fichiers sélectionnés, !/ dossier actuel, !@ hôte, !U utilisateur, !# port, !N nom du site, !?Question :?défaut! demande une valeur, !! un ! littéral. Les noms et les réponses sont protégés pour le shell."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "! nazwa pliku, !& zaznaczone pliki, !/ bieżący folder, !@ host, !U użytkownik, !# port, !N nazwa witryny, !?Pytanie:?domyślna! pyta o wartość, !! dosłowny znak !. Nazwy i odpowiedzi są cytowane dla powłoki."
          }
        }
      }
    },
