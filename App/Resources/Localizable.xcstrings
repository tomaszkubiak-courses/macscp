    "The server %@:%@ is not in your known hosts. Its %@ key fingerprint is:\n\n%@\n\nOnly continue if you trust this server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server %@:%@ steht nicht in deinen bekannten Hosts. Der Fingerabdruck seines %@-Schlüssels:\n\n%@\n\nFahre nur fort, wenn du diesem Server vertraust."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The server %1$@:%2$@ is not in your known hosts. Its %3$@ key fingerprint is:\n\n%4$@\n\nOnly continue if you trust this server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor %@:%@ no está en tus hosts conocidos. La huella de su clave %@ es:\n\n%@\n\nContinúa solo si confías en este servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur %@:%@ ne figure pas dans vos hôtes connus. L’empreinte de sa clé %@ est :\n\n%@\n\nNe continuez que si vous faites confiance à ce serveur."
          }
        },
