    "The %@ key of %@:%@ does not match the one in your known hosts. Someone may be intercepting the connection, or the server was reinstalled. New fingerprint:\n\n%@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der %@-Schlüssel von %@:%@ stimmt nicht mit dem in deinen bekannten Hosts überein. Jemand könnte die Verbindung abfangen, oder der Server wurde neu installiert. Neuer Fingerabdruck:\n\n%@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The %1$@ key of %2$@:%3$@ does not match the one in your known hosts. Someone may be intercepting the connection, or the server was reinstalled. New fingerprint:\n\n%4$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave %@ de %@:%@ no coincide con la de tus hosts conocidos. Alguien podría estar interceptando la conexión, o el servidor se reinstaló. Nueva huella:\n\n%@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé %@ de %@:%@ ne correspond pas à celle de vos hôtes connus. Quelqu’un intercepte peut-être la connexion, ou le serveur a été réinstallé. Nouvelle empreinte :\n\n%@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucz %@ serwera %@:%@ nie zgadza się z kluczem w znanych hostach. Ktoś może przechwytywać połączenie albo serwer został przeinstalowany. Nowy odcisk:\n\n%@"
          }
        }
      }
    },
    "The TLS certificate of %@:%@ is not trusted: %@\n\nSubject: %@\nIssuer: %@\nSHA-256 fingerprint:\n%@\n\nOnly continue if you trust this server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dem TLS-Zertifikat von %@:%@ wird nicht vertraut: %@\n\nInhaber: %@\nAussteller: %@\nSHA-256-Fingerabdruck:\n%@\n\nFahre nur fort, wenn du diesem Server vertraust."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The TLS certificate of %1$@:%2$@ is not trusted: %3$@\n\nSubject: %4$@\nIssuer: %5$@\nSHA-256 fingerprint:\n%6$@\n\nOnly continue if you trust this server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El certificado TLS de %@:%@ no es de confianza: %@\n\nSujeto: %@\nEmisor: %@\nHuella SHA-256:\n%@\n\nContinúa solo si confías en este servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le certificat TLS de %@:%@ n’est pas fiable : %@\n\nSujet : %@\nÉmetteur : %@\nEmpreinte SHA-256 :\n%@\n\nNe continuez que si vous faites confiance à ce serveur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certyfikat TLS serwera %@:%@ nie jest zaufany: %@\n\nPodmiot: %@\nWystawca: %@\nOdcisk SHA-256:\n%@\n\nKontynuuj tylko wtedy, gdy ufasz temu serwerowi."
          }
        }
      }
    },
    "The existing item is overwritten." : {
      "localizations" : {
